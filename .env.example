# Neon PostgreSQL Connection URLs
# DATABASE_URL: Pooled connection URL (with -pooler in hostname) for runtime queries
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct connection URL (without -pooler in hostname) for Prisma migrations & schema push
DIRECT_URL="postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional local PostgreSQL fallback (e.g. for offline local dev)
POSTGRES_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/progress_db?schema=public"

# Auth configuration
AUTH_SECRET="your-32-character-secret-key-for-session-tokens"
ALLOW_DEV_DEMO_USER="false" # Never set to "true" in production

# Optional LLM API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
